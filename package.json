{
  "name": "@nerima-games/mc-compose",
  "version": "0.2.10",
  "type": "module",
  "description": "The composition repository for the nerima-games Minecraft-clone rebuild: Layer merge, the single total ordering of frame stages, session lifecycle, the QA/debug API and the modding entry point. It holds no game rules.",
  "homepage": "https://github.com/nerima-games/mc-compose#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-compose.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-compose/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "tsconfig.base.json",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "composition",
    "frame-stages"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.preview.json --pretty false",
    "lint": "oxlint --deny-warnings src scripts test apps e2e && ast-grep scan",
    "lint:fix": "oxlint --fix src scripts test apps e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "vitest run test/e2e",
    "dev": "vite",
    "build:web": "vite build",
    "e2e:browser": "playwright test",
    "check:roster": "tsx scripts/check-roster-manifest.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@nerima-games/mc-audio": "0.2.8",
    "@nerima-games/mc-kernel": "0.7.1",
    "@nerima-games/mc-physics": "0.2.2",
    "@nerima-games/mc-playground-kit": "0.3.1",
    "@nerima-games/mc-render": "0.6.0",
    "@nerima-games/mc-save": "0.4.2",
    "@nerima-games/mc-sim": "0.4.2",
    "@nerima-games/mc-worldgen": "0.3.2",
    "@nerima-games/mx-gameplay": "0.6.0",
    "@nerima-games/mx-multiplayer": "0.11.0",
    "@nerima-games/mx-redstone": "0.3.3",
    "@nerima-games/mx-ui": "0.5.3",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@effect/vitest": "0.30.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@types/three": "0.185.4",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.11",
    "knip": "6.33.0",
    "three": "0.185.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  }
}
