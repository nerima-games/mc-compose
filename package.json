{
  "name": "@nerima-games/mc-compose",
  "version": "0.1.0",
  "type": "module",
  "description": "The composition repository for the nerima-games Minecraft-clone rebuild: Layer merge, the single total ordering of frame stages, session lifecycle, the QA/debug API and the modding entry point. It holds no game rules.",
  "homepage": "https://github.com/nerima-games/mc-compose#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-compose.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-compose/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "domain",
    "tsconfig.base.json",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "composition",
    "frame-stages"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false",
    "lint": "oxlint --deny-warnings index.ts domain scripts test apps e2e",
    "lint:fix": "oxlint --fix index.ts domain scripts test apps e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "vitest run test/e2e",
    "dev": "vite",
    "build:web": "vite build",
    "typecheck:app": "tsc -p tsconfig.app.json --pretty false",
    "e2e:browser": "playwright test",
    "check:deps": "tsx scripts/check-dependency-whitelist.ts",
    "check:roster": "tsx scripts/check-roster-manifest.ts",
    "api:check": "tsx scripts/api-lock.ts",
    "api:update": "tsx scripts/api-lock.ts --write",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:deps && pnpm api:check && pnpm test"
  },
  "dependencies": {
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@playwright/test": "^1.62.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.1",
    "@vitest/coverage-v8": "^3.2.7",
    "oxlint": "^1.76.0",
    "three": "^0.185.1",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.1.5",
    "vitest": "^3.2.7"
  }
}
