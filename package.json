{
  "name": "@nerima-games/mc-compose",
  "version": "0.1.4",
  "type": "module",
  "description": "The composition repository for the nerima-games Minecraft-clone rebuild: Layer merge, the single total ordering of frame stages, session lifecycle, the QA/debug API and the modding entry point. It holds no game rules.",
  "homepage": "https://github.com/nerima-games/mc-compose#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-compose.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-compose/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.15.0"
  },
  "packageManager": "pnpm@9.15.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "tsconfig.base.json",
    "LICENSE",
    "README.md"
  ],
  "pnpm": {
    "overrides": {
      "@nerima-games/mc-kernel": "0.2.8"
    }
  },
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "composition",
    "frame-stages"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false",
    "lint": "oxlint --deny-warnings src scripts test apps e2e",
    "lint:fix": "oxlint --fix src scripts test apps e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "vitest run test/e2e",
    "dev": "vite",
    "build:web": "vite build",
    "typecheck:preview": "tsc -p tsconfig.preview.json --pretty false",
    "e2e:browser": "playwright test",
    "check:roster": "tsx scripts/check-roster-manifest.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@nerima-games/mc-audio": "0.1.0",
    "@nerima-games/mc-kernel": "0.2.8",
    "@nerima-games/mc-render": "0.1.1",
    "@nerima-games/mc-save": "0.1.0",
    "@nerima-games/mc-sim": "0.1.24",
    "@nerima-games/mc-worldgen": "0.1.1",
    "@nerima-games/mx-gameplay": "0.1.35",
    "@nerima-games/mx-multiplayer": "0.1.1",
    "@nerima-games/mx-redstone": "0.1.5",
    "@nerima-games/mx-ui": "0.2.6",
    "effect": "^3.20.0"
  },
  "devDependencies": {
    "@nerima-games/mc-playground-kit": "0.1.1",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@effect/vitest": "^0.25.1",
    "@playwright/test": "^1.50",
    "@types/node": "^22.19.11",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "oxlint": "^0.12.0",
    "three": "^0.170.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7",
    "vitest": "^3.2.4",
    "ws": "^8.21.1"
  }
}
