{
  "$schema": "https://oxc-project.github.io/oxc/schema/linter.json",
  // oxlint is the ONLY lint/format configuration in this repository.
  // There is deliberately no prettier, no biome and no .editorconfig.
  //
  // NOTE on the `Date.now()` ban (see README 現状): `scripts/check-dependency-whitelist.ts`
  // used to enforce this (it banned Date.now() / new Date() / performance.now() in favour of
  // the injected clock Port). That script was removed org-wide in favour of oxlint's
  // `no-restricted-imports` for the cross-repo dependency graph (DEPENDENCY_POLICY.md §5,
  // PACKAGE_STANDARD.md "scripts/check-dependency-whitelist.ts の廃止"), which does not cover
  // raw clock reads. As of this PR (oxlint is now Nix-provided, not a package.json pin —
  // see flake.nix), the real oxlint binary still does not implement `no-restricted-syntax`
  // or `no-restricted-properties` (absent from `oxlint --rules`), so a raw `Date.now()` /
  // `new Date()` / `performance.now()` call is still not banned by this file. Per org policy
  // this ban is not required to have a replacement script (PACKAGE_STANDARD.md leaves it to
  // each repository's discretion); none is added here. When oxlint gains
  // `no-restricted-syntax`, this is the place to add the ban.
  "env": {
    "es2022": true,
    "node": true
  },
  "settings": {
    "typescript": {
      "version": "5.9"
    }
  },
  "plugins": [],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn",
    "style": "warn",
    "restriction": "warn"
  },
  "rules": {
    // TypeScript-specific rules
    // Prefer `type` over `interface` for pure data types (Schema.Struct pattern).
    "@typescript-eslint/consistent-type-definitions": ["warn", "type"],
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-floating-promises": "warn",
    "@typescript-eslint/no-misused-new": "warn",
    "@typescript-eslint/no-unnecessary-type-assertion": "warn",
    "@typescript-eslint/no-var-requires": "warn",
    "@typescript-eslint/prefer-enum-initializers": "warn",
    "@typescript-eslint/prefer-for-of": "warn",
    "@typescript-eslint/prefer-literal-enum-member": "warn",

    // Correctness
    "no-array-constructor": "warn",
    "no-empty": "warn",
    "no-eq-null": "warn",
    "no-extra-boolean-cast": "warn",
    "no-fallthrough": "warn",
    "no-irregular-whitespace": "warn",
    "no-self-compare": "warn",
    "no-throw-literal": "warn",
    "no-unreachable": "warn",
    "use-isnan": "warn",
    "valid-typeof": "warn",

    // Suspicious
    "no-console": "warn",
    "no-debugger": "warn",
    "no-empty-function": "warn",
    "no-empty-pattern": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-redeclare": "warn",
    "no-shadow": "warn",
    "no-unreachable-loop": "warn",
    "no-unused-private-class-members": "warn",

    // Performance
    "no-await-in-loop": "warn",
    "no-loop-func": "warn",
    "no-promise-executor-return": "warn",
    "no-sync": "warn",

    // Style
    //
    // The Nix-provided oxlint (nixpkgs, ~1.73 as of this PR) rejects the
    // config outright — a hard parse error, not a silent skip — for any rule
    // name it does not recognise. Verified empirically: loading this file
    // unmodified against that version fails with "Rule '<name>' not found in
    // plugin 'eslint'" for every purely-formatting ESLint rule this file used
    // to carry (array-bracket-spacing, block-spacing, brace-style, camelcase,
    // comma-dangle, comma-spacing, comma-style, computed-property-spacing,
    // eol-last, func-call-spacing, indent, key-spacing, keyword-spacing,
    // linebreak-style, lines-between-class-members, no-mixed-spaces-and-tabs,
    // no-new-object, no-tabs, no-trailing-spaces, no-whitespace-before-property,
    // object-curly-spacing, one-var, operator-linebreak, padded-blocks,
    // quote-props, semi-spacing, space-before-blocks, space-infix-ops,
    // space-unary-ops, spaced-comment). Those existed under oxlint 0.12.0 (the
    // version this repository pinned before this PR) but oxc has since
    // dropped pure-formatting rules from the linter in favour of a separate
    // formatter; they are not renamed, they are gone. There is deliberately no
    // replacement here (no prettier, no biome, no .editorconfig — see the file
    // header) and no formatter added by this PR; only the two Style rules the
    // real oxlint binary still recognises survive.
    "no-array-method-this-argument": "warn",
    "no-bitwise": "warn",
    // StageId (Brand.refined) and Context.Tag are effect-ts factory functions, not
    // constructors — `new StageId(...)` / `new Context.Tag(...)` would throw at runtime.
    // The rule's own message names this exact escape hatch ("add it to the exceptions list
    // if it should not be called with new"). Verified empirically against the real Nix
    // oxlint 1.73.0 binary: `capIsNewExceptions` matches by the called identifier's own
    // name, so a member-expression call like `Context.Tag(...)` is matched by `Tag`, not
    // `Context.Tag`.
    "new-cap": ["warn", { "capIsNewExceptions": ["StageId", "Tag"] }],

    // Restriction
    "default-case": "warn",
    "default-case-last": "warn",
    "no-empty-character-class": "warn",
    // Was declared for intent only and was inert under the oxlint 0.12.0 this repository
    // used to pin (listed by `oxlint --rules` but unimplemented; verified empirically: a
    // file reading the bare global `name` produced 0 diagnostics). As of this PR, oxlint is
    // Nix-provided (flake.nix) instead, and the real binary DOES implement this rule —
    // verified empirically against the same kind of file, which now reports
    // `eslint(no-restricted-globals): Unexpected use of 'name'`. There is deliberately no
    // replacement script: `scripts/check-dependency-whitelist.ts`, which used to be the real
    // enforcement here, was deleted org-wide by an earlier migration (DEPENDENCY_POLICY.md
    // §5) and is not coming back.
    "no-restricted-globals": ["warn", "name", "open", "close", "event"],
    // mc-compose is Tier4, the apex of the dependency graph (DEPENDENCY_POLICY.md §1): it
    // may depend on mc-audio, mc-render, mc-save, mc-sim, mc-worldgen, mx-gameplay,
    // mx-redstone, mx-ui and mx-multiplayer (all declared in package.json#dependencies),
    // plus mc-kernel (universally importable, and therefore deliberately absent from both
    // package.json's allowlist reasoning and this list — DEPENDENCY_POLICY.md §2 rule 5).
    // As of this PR, mc-playground-kit is ALSO a real `dependencies` entry, not the usual
    // devDependency-only exception (DEPENDENCY_POLICY.md §3): apps/web/main.ts's shipped
    // production bootstrap (container/canvas mount, network pump, cleanup lifecycle) calls
    // `makeBrowserPreview` unconditionally, so this repository is the one place in the org
    // where that harness is legitimately runtime code, not test/preview-only glue. The
    // `no-restricted-imports` pattern that used to ban it here has been removed accordingly
    // — DEPENDENCY_POLICY.md §3 updated to record the exception.
    // Unlike every other Tier, there is close to nothing left to forbid here; the one
    // `patterns` entry below is the only thing that is NOT licensed even though it is
    // reachable on disk. (The `effect` entry moved into `paths` here too — the bare
    // object form used previously is not part of the rule's real schema, which requires
    // `paths`/`patterns` wrapper keys; https://oxc.rs/docs/guide/usage/linter/rules/eslint/no-restricted-imports.)
    //
    // STATUS as of the Nix-provided-oxlint PR (2026-08): this file is named
    // `.oxlintrc.json` (the only filename oxlint auto-discovers — fixed in an earlier PR,
    // replacing the previous `oxlint.json` which was never picked up), and oxlint itself is
    // now supplied by the Nix devShell (flake.nix) instead of the `^0.12.0` package.json pin
    // this repository used to carry. 0.12.0's `-c/--config` was "(experimental)" and did not
    // auto-discover any filename without it, and even loaded explicitly this rule did not
    // appear in `oxlint --rules` and never fired — it was simply unimplemented. The
    // Nix-provided oxlint (nixpkgs, ~1.73 as of this PR) fixes both problems at once: this
    // file is auto-discovered with no `-c` flag needed, and `no-restricted-imports` is a real,
    // implemented rule. Verified empirically: a file importing
    // `@nerima-games/mc-playground-kit` now genuinely produces
    // `eslint(no-restricted-imports)` and fails `pnpm lint`'s `--deny-warnings` — the first
    // time this repository's Tier4 dependency rule has ever mechanically fired. (There was no
    // need to also take the `feat/modernize-toolchain` branch's package.json version bump —
    // that branch bumps the npm-resolved `oxlint` devDependency to `^1.76.0` instead; this PR
    // removes the devDependency line entirely and gets a working, real oxlint from Nix.)
    "no-restricted-imports": [
      "warn",
      {
        "paths": [
          {
            "name": "effect",
            "message": "Please use named imports from 'effect' package",
            "importNames": ["default"]
          }
        ],
        "patterns": [
          {
            "regex": "^@nerima-games/(mc-noise|mc-meshing|mc-physics)(/.*)?$",
            "message": "mc-compose reaches these only transitively through mc-worldgen/mc-sim/mc-render. Reaching through a dependency is not an import licence (DEPENDENCY_POLICY.md §2, no-transitive-closure)."
          }
        ]
      }
    ],
    "prefer-template": "warn",

    // Disabled rules (conflict with project style)
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "no-case-declarations": "off",
    "no-constant-condition": "off",
    "no-param-reassign": "off",
    "no-plusplus": "off"
  },
  // Scoped strictness (org policy, decided 2026-08-08): src/** stays fully strict — magic
  // numbers get named constants, short identifiers get renamed, real fixes only, no disable
  // comments. test/**, scripts/**, apps/** and e2e/** are non-shipped tooling and fixture
  // code where these style rules fire on long-accepted patterns (test assertions using
  // literal expected values, scripts printing to stdout, generated/host glue code with many
  // parameters) rather than real defects; mass-rewriting them for style risks silent
  // assertion corruption for zero behavioral value. This override was inert until oxlint was
  // renamed from oxlint.json to .oxlintrc.json (see the header note above) and its ~14k
  // warnings across this surface were never actually enforced before that rename.
  "overrides": [
    {
      "files": ["test/**", "scripts/**", "apps/**", "e2e/**"],
      "rules": {
        "no-magic-numbers": "off",
        "id-length": "off",
        "sort-keys": "off",
        "sort-imports": "off",
        "no-undefined": "off",
        "curly": "off",
        "no-ternary": "off",
        "no-nested-ternary": "off",
        "capitalized-comments": "off",
        "no-underscore-dangle": "off",
        "max-statements": "off",
        "max-params": "off",
        "prefer-destructuring": "off",
        "new-cap": "off",
        "func-names": "off",
        "func-style": "off",
        "arrow-body-style": "off",
        "no-continue": "off",
        "no-await-in-loop": "off",
        "no-use-before-define": "off",
        "init-declarations": "off",
        "no-shadow": "off",
        "no-console": "off",
        "complexity": "off",
        "no-void": "off",
        "no-eq-null": "off",
        "no-bitwise": "off",
        "prefer-object-has-own": "off",
        "prefer-named-capture-group": "off",
        "prefer-const": "off",
        "default-case": "off",
        "no-empty-function": "off",
        // Protocol/simulation code intentionally matches control bytes and captures
        // variables mutated by an awaited call the linter cannot see into (polling loops,
        // shared-future drain patterns); rethrows of a caught `unknown` value are correct
        // and preserve error fidelity better than wrapping. Verified per-site before adding.
        "no-control-regex": "off",
        "no-unmodified-loop-condition": "off",
        "no-promise-executor-return": "off",
        "no-unsafe-optional-chaining": "off",
        "no-implicit-coercion": "off",
        "no-loop-func": "off",
        "no-throw-literal": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules/**", "coverage/**", "dist/**", ".git/**", "*.config.ts", "docs/**"]
}
